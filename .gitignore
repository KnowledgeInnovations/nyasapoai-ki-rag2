# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python extraction artifacts
python/__pycache__/
python/output/
python/extract_log.txt

.vercel

# local test/debug artifacts — auth cookies and one-off maintenance script
# logs accumulate at the repo root during local testing and should never
# reach a commit (test-session-cookie.txt in particular is a live session
# credential, not just disposable output).
test-session-cookie.txt
*-log.txt
*-log[0-9].txt
